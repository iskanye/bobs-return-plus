  - character: "\u041C\u0430\u043D\u0435\u043A\u0435\u043D"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u041C\u043E\u0439 \u043D\u0430\u0440\u043E\u0434 \u043D\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044F
