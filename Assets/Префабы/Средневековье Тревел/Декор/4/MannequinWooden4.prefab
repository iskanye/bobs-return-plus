  - character: "\u041C\u0430\u043D\u0435\u043A\u0435\u043D"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u041D\u0430\u0448\u0438 \u043F\u0443\u0442\u0438 \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u043B\u0438\u0441\u044C
