    emotionId: 0
    delay: 0
    text: "\u041E \u0445\u0440\u0430\u0431\u0440\u044B\u0439 \u0440\u044B\u0446\u0430\u0440\u044C,
      \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0438\u0439 \u0430\u0440\u043A\u0443
