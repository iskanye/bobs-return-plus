  m_Script: {fileID: 11500000, guid: 613d5eea99f9bff1c8f0fb7687a3251e, type: 3}
  m_Name: Start
  m_EditorClassIdentifier: 
  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u0432 \u0441\u0440\u0435\u0434\u043D\u0435\u0432\u0435\u043A\u043E\u0432\u044C\u0435! "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u0423\u0432\u044B, \u043D\u0435 \u0432\u0441\u0435 \u0432\u0435\u043B\u0438\u043A\u0438\u0435
      \u0433\u0435\u0440\u043E\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u0441\u0432\u043E\u0439 \u043F\u0443\u0442\u044C \u0438\u0437 \u0443\u044E\u0442\u043D\u044B\u0445
      \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u044C, \u043D\u043E \u0442\u0430\u043A\u043E\u0439
      \u043F\u0440\u0438\u0451\u043C \u0441\u0430\u043C\u044B\u0439 \u043E\u0431\u044B\u043A\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u0439
      \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u0425\u043E\u0447\u0443 \u043F\u043E\u0437\u0434\u0440\u0430\u0432\u0438\u0442\u044C
      \u0442\u0435\u0431\u044F \u0441 \u0443\u0441\u043F\u0435\u0448\u043D\u044B\u043C
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435\u043C \u0432\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u043D\u0438 \u043E\u0434\u043D\u0430 \u0442\u0432\u043E\u044F \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u044C
      \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043B\u0430\u0441\u044C
      \u043F\u043E \u043F\u0443\u0442\u0438. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u041D\u043E \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u044F \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u044D\u0442\u043E\u0439 \u044D\u043F\u043E\u0445\u0438, \u043B\u0443\u0447\u0448\u0435
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0437\u0430 \u043D\u0438\u043C\u0438
      \u043F\u0440\u0438\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u041D\u0435 \u0431\u0443\u0434\u0435\u043C \u0442\u044F\u043D\u0443\u0442\u044C
      \u0432\u0440\u0435\u043C\u044F, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u043C\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u043C\u0441\u044F \u0432
      \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435 \u043F\u043E\u0434
      \u0437\u0430\u043C\u043A\u043E\u043C. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u042F \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u043B \u043C\u0430\u0448\u0438\u043D\u0443
      \u043D\u0430 \u043E\u0434\u043D\u0443 \u0438\u0437 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u043D\u044B\u0445
      \u0431\u0430\u0448\u0435\u043D \u044D\u0442\u043E\u0433\u043E \u0437\u0430\u043C\u043A\u0430,
      \u0438 \u0442\u0435\u0431\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0434\u043E \u043D\u0435\u0451."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u0410 \u0432\u043E\u0442 \u0438 \u0442\u0432\u043E\u044F \u043F\u0435\u0440\u0432\u0430\u044F
      \u0437\u0430\u0434\u0430\u0447\u0430 - \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0438\u0437 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u0418\u043B\u0438 \u0438\u0437 \u044D\u0442\u043E\u0439 \u043A\u0430\u043C\u0435\u0440\u044B... "
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0422\u0440\u0435\u0432\u0435\u043B \u0411\u043E\u0431"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u0412\u0430\u0443, \u043D\u0435\u0443\u0436\u0435\u043B\u0438 \u044F
      - \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436!?"
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
