  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 613d5eea99f9bff1c8f0fb7687a3251e, type: 3}
  m_Name: "\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435"
  m_EditorClassIdentifier: 
  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u041E\u0433\u043E, \u0411\u043E\u0431, \u043F\u043E\u0445\u043E\u0436\u0435
      \u0442\u044B \u043D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E \u0441\u043C\u043E\u0433
      \u043E\u0442\u044B\u0441\u043A\u0430\u0442\u044C \u0441\u0435\u0431\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0435
      \u043E\u0440\u0443\u0436\u0438\u0435!"
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u0422\u043E\u043F\u043E\u0440, \u0430 \u0438\u043C\u0435\u043D\u043D\u043E
      \u0441\u0435\u043A\u0438\u0440\u0430, \u043E\u0442\u043B\u0438\u0447\u043D\u043E
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0442\u0435\u0431\u0435 \u0432
      \u0441\u0440\u0430\u0436\u0435\u043D\u0438\u044F\u0445 \u043D\u0430 \u0431\u043B\u0438\u0436\u043D\u0435\u0439
      \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438."
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u0442\u0430\u043A\u0438\u043C
      \u0442\u043E\u043F\u043E\u0440\u043E\u043C \u043C\u043E\u0436\u043D\u043E \u0440\u0443\u0431\u0438\u0442\u044C
      \u0434\u0435\u0440\u0435\u0432\u043E! "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u041D\u0435 \u0437\u0440\u044F \u0436\u0435 \"\u0441\u0435\u043A\u0438\u0440\u0430\"
      \u0438 \"\u0442\u043E\u043F\u043E\u0440\" \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0441\u0438\u043D\u043E\u043D\u0438\u043C\u0430\u043C\u0438, \u0445\u0435\u0445."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0422\u0440\u0435\u0432\u0435\u043B"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u041D\u0435 \u0437\u0440\u044F \u0436\u0435 \"\u0441\u0435\u043A\u0438\u0440\u0430\"
      \u0438 \"\u0442\u043E\u043F\u043E\u0440\" \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0441\u0438\u043D\u043E\u043D\u0438\u043C\u0430\u043C\u0438, \u0445\u0435\u0445."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
