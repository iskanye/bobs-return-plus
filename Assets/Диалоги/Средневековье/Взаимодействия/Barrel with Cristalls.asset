  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    text: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E, \u0411\u043E\u0431,
      \u0442\u044B \u043D\u0430\u0442\u043A\u043D\u0443\u043B\u0441\u044F \u043D\u0430
      \u0441\u0430\u043C\u044B\u0439 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u043A\u043B\u0430\u0434. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    text: "\u041F\u0440\u0430\u0432\u0434\u0430, \u044F \u043D\u0435 \u0434\u0443\u043C\u0430\u044E,
      \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C
      \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u0435\u0449\u0451 \u043E\u0434\u043D\u043E\u0439
      \u0432\u0430\u043B\u044E\u0442\u044B."
