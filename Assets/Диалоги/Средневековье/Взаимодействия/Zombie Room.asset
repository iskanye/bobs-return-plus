  m_Script: {fileID: 11500000, guid: 613d5eea99f9bff1c8f0fb7687a3251e, type: 3}
  m_Name: Zombie Room
  m_EditorClassIdentifier: 
  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    text: "\u0411\u043E\u0431, \u0431\u0443\u0434\u044C \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0435. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    text: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0442\u044B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B
      \u0441\u0432\u043E\u0435\u0433\u043E \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    text: "\u042D\u0442\u043E \u0436\u0438\u0432\u043E\u0439 \u043C\u0435\u0440\u0442\u0432\u0435\u0446. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    text: "\u0421\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u043D\u0435\u0437\u0430\u0434\u043E\u043B\u0433\u043E
      \u0434\u043E \u0433\u0438\u0431\u0435\u043B\u0438 \u044D\u0442\u043E\u0442
      \u0431\u0435\u0434\u043D\u044F\u0433\u0430 \u0431\u044B\u043B \u0437\u0430\u0440\u0430\u0436\u0451\u043D
      \u043E\u0441\u043E\u0431\u044B\u043C \u0432\u0438\u0434\u043E\u043C \u0447\u0443\u043C\u044B."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    text: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0442\u0435\u0431\u0435
      \u0443\u0434\u0430\u0441\u0442\u0441\u044F \u0447\u0435\u043C-\u0442\u043E
      \u043E\u0442\u0432\u043B\u0435\u0447\u044C \u0435\u0433\u043E. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    text: "\u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043F\u043E\u0434 \u043D\u043E\u0433\u0438, \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u043D\u0430 \u0447\u0442\u043E-\u0442\u043E
      \u0448\u0443\u043C\u043D\u043E\u0435."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
