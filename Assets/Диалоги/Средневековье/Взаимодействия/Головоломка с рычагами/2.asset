  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    text: "\u0411\u044B\u0441\u0442\u0440\u0435\u0435 \u0438\u0449\u0438 \u0441\u043F\u043E\u0441\u043E\u0431
