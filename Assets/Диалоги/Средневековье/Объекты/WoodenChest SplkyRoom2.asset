  dialogues:
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u0412 \u0442\u044F\u0436\u043A\u0438\u0435 \u0434\u043D\u0438 \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044E
      \u043D\u0430\u0434\u043E\u0431\u043D\u043E \u0441\u0440\u0435\u0434\u044C \u0442\u044B\u0441\u044F\u0447\u0438
      \u0442\u0449\u0435\u0442\u043D\u044B\u0445 \u0434\u0443\u0440\u043D\u0435\u0439
      \u043E\u0442\u043E\u0431\u0440\u0430\u0442\u044C \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439
      \u043E\u0442\u0440\u044F\u0434, \u0430\u0441\u044C \u043E\u0431\u044F\u0437\u0430\u043D
      \u0431\u0443\u0434\u0435\u0442 \u0432\u043E\u043A\u0440\u0443\u0433 \u0434\u0430
      \u043E\u043A\u043E\u043B\u043E \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0430\u0442\u044C
      \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F."
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u0428\u0451\u043B \u0431\u044B \u0438 \u0441\u0430\u043C \u0432 \u0432\u043E\u0438\u043D\u044B,
      \u0434\u0430 \u043A\u0442\u043E \u0436 \u0443\u0447\u0438\u043D\u0438\u0442
      \u0434\u043B\u044F \u043E\u0441\u043E\u0431\u044B\u0445 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u0443\u044E
      \u0433\u043E\u0440\u043D\u0438\u0446\u0443? "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u0414\u0430 \u0438 \u0441\u043F\u0438\u043D\u0430 \u043C\u043E\u044F
      \u0434\u0440\u044F\u0445\u043B\u0430\u044F \u043D\u0435 \u0433\u043E\u0436\u0430
      \u0443\u0436\u0435 \u043D\u0438 \u043D\u0430 \u0447\u0442\u043E \u043E\u043D\u043E\u0435... "
