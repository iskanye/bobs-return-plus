    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u0412\u0435\u0434\u044C \u043D\u0435 \u0434\u0443\u043C\u0430\u0442\u044C
      \u0430\u0441\u044C \u0432\u043B\u0435\u0447\u0435\u043D\u044C\u0435 \u043C\u043E\u0435
      \u043A \u0440\u0438\u0441\u043E\u0432\u0430\u043D\u0438\u044E \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
