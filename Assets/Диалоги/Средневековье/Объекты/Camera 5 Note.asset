  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u0427\u0451\u0440\u043D\u043E\u0433\u043E \u043C\u043E\u0440\u0430 \u0440\u0430\u0431\u043E\u0442\u0430
