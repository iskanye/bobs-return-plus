    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0440\u043E\u0434\u043D\u044B\u0445 \u043F\u043E\u0433\u0440\u0435\u0431\u0430\u0435\u0442,
