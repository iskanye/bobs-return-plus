    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 1
    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
