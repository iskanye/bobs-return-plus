    delay: 0
    text: "\"\u0411\u044B\u0432\u0430\u0442\u0438 \u0430\u0437\u044A \u0432 \u0430\u0431\u044B\u043A\u043D\u0430\u0432\u0435\u043D\u0430\u044F
