  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\"\u0414\u0435\u0443\u0441 \u0435\u0440\u0440\u043E! "
