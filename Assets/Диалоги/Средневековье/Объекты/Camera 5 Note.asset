    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u043D\u0435\u043A\u0440\u043E\u043C\u0430\u043D\u0442
