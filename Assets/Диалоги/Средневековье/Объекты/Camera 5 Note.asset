    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u041D\u044B\u043D\u0435 \u0435\u0441\u0438 \u0447\u0435\u0441\u0442\u044C
      \u0433\u043D\u0438\u0442\u044C \u043F\u043E\u0434 \u0437\u0430\u043C\u043A\u043E\u043C
