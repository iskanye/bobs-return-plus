    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u041D\u0438 \u0441\u043B\u043E\u0432\u0430 \u043D\u0435 \u0440\u0430\u0437\u043E\u0443\u043C\u0438\u043B."
