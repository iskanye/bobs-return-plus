  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u041E\u043A\u043E\u043B\u043E \u0432\u0441\u044E\u0434\u0443 \u043A\u0430\u0448\u043B\u044F\u0442
      \u0438 \u043A\u0430\u0448\u043B\u044F\u0442 \u043F\u0440\u0430\u043A\u043B\u044F\u0442\u044B\u0435. "
