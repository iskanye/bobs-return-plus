  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u041E\u043D \u0431\u044B\u0442\u044C \u043F\u043E\u043B\u043E\u043D \u0434\u0443\u043C. "
    startDelay: 0
