  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u041C\u043D\u043E\u0433\u043E \u0432\u0435\u0441\u0442\u0435\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0445
