    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u0410\u0437\u044A \u0436\u0435 \u043F\u043E\u0442\u043E\u043B\u043A\u043E\u0432\u0430\u0442\u0438
