  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u0412 \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C \u043F\u0440\u0438\u0432\u043E\u043B\u043E\u043A\u043B\u0438
