    dontWait: 0
    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u041C\u0443\u0436\u0438\u043A \u0441\u0438\u044F \u0431\u043B\u0438\u0437\u043A\u043E
      \u043A \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044E \u0441\u0442\u043E\u044F\u0442\u044C. "
