  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0432 \u044D\u0442\u043E\u0439
      \u043A\u0430\u043C\u0435\u0440\u0435 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u043B\u0430\u0436\u043D\u043E, \u0447\u0442\u043E \u043E\u043D\u0430
      \u043F\u043E\u0440\u043E\u0441\u043B\u0430 \u043C\u0445\u043E\u043C. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u041D\u043E \u0435\u0441\u0442\u044C \u043B\u0438 \u0432 \u0442\u0432\u043E\u0435\u0439
      \u0431\u0430\u0437\u0435 \u0434\u0430\u043D\u043D\u044B\u0445 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u043E \u0435\u0433\u043E \u0446\u0435\u043B\u0435\u0431\u043D\u044B\u0445
      \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430\u0445?"
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    delay: 0
    text: "\u042D\u0442\u0438 \u0441\u043F\u043E\u0440\u043E\u0432\u044B\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B \u043F\u043E\u0433\u043B\u043E\u0449\u0430\u0442\u044C
      \u043B\u044E\u0431\u0443\u044E \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C
      \u0432 20 \u0440\u0430\u0437 \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0432\u0435\u0441\u0430, \u0442\u0430\u043A \u0447\u0442\u043E \u043C\u043E\u0445
      \u0437\u0430\u043F\u0440\u043E\u0441\u0442\u043E \u043C\u043E\u0436\u0435\u0442
      \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0442\u0435\u0431\u0435 \u043F\u043E\u0432\u044F\u0437\u043A\u0443
      \u043D\u0430 \u0440\u0430\u043D\u0443.\n"
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0422\u0440\u0435\u0432\u0435\u043B"
