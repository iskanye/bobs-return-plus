  dialogues:
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u0411\u043B\u0438\u0437\u0438\u0442 \u0441\u0435\u0431\u044F \u043A \u043A\u043E\u043D\u0446\u0443
      \u0442\u0440\u0443\u0434 \u043D\u0430\u0434 \u043B\u0443\u0447\u0448\u0438\u043C
      \u043C\u0435\u0441\u0442\u043E\u043C \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439,
      \u043A\u043E\u0435\u043C\u0443 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0437\u0430\u0432\u0438\u0434\u043E\u0432\u0430\u0442\u044C
      \u0441\u0430\u043C\u044B\u0439 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439
      \u0445\u0440\u0430\u043C \u0441 \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430\u043C\u0438."
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u041C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440\u043E\u0432
      \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u043B\u0438 \u0441\u0432\u043E\u0438
      \u043C\u0451\u0440\u0442\u0432\u044B\u0435 \u0431\u0435\u0441\u0435\u0434\u044B,
      \u043A\u043E\u0433\u0434\u0430 \u0430\u0437\u044A \u043D\u0430\u0447\u0438\u043D\u0430\u043B
      \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C \u0440\u0430\u0431\u043E\u0442\u0443
      \u043F\u044B\u0442\u043E\u0447\u043D\u044B\u0445 \u043E\u0440\u0443\u0434\u0438\u0439
      \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F."
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u0427\u0442\u043E? "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u0425\u043E\u0447\u0435\u0448\u044C \u0443\u0441\u043B\u044B\u0445\u0430\u0442\u044C? "
    startDelay: 0
