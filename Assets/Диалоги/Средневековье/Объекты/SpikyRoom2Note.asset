    dontWait: 0
    cantSkip: 0
  - character: ???
    dialogueCharacter: {fileID: 0}
    emotionId: 0
    color: {r: 1, g: 1, b: 1, a: 1}
    delay: 0
    text: "\u041D\u0443-\u0441, \u0435\u0436\u0435 \u043D\u0430\u0447\u0430\u0442\u044C
      \u0432\u043E\u043D \u0441 \u0442\u0435\u0445 \u0448\u0438\u043F\u043E\u0432... "
