  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 2
    delay: 0
    text: "\u041E\u0433\u043E, \u0411\u043E\u0431, \u0430 \u0442\u044B \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u0440\u0430\u0441\u0445\u0438\u0442\u0438\u0442\u0435\u043B\u044C \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u0438\u0439. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 2
    delay: 0
    text: "\u0422\u043E, \u0447\u0442\u043E \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0432 \u0442\u0432\u043E\u0438\u0445 \u0440\u0443\u043A\u0430\u0445, - \u043E\u0434\u043D\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u044F\u044F
      \u0441\u0435\u043A\u0438\u0440\u0430."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0421\u0435\u043A\u0438\u0440\u0430 \u0431\u044B\u043B\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430
      \u0441 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0433\u043E \u0432\u0435\u043A\u0430
      \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C
      \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u043F\u0435\u0448\u0438\u043C\u0438
      \u0432\u043E\u0438\u043D\u0430\u043C\u0438."
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u042D\u0442\u043E\u0442 \u0442\u043E\u043F\u043E\u0440 \u043C\u043E\u0436\u043D\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043A\u0430\u043A
      \u0432 \u0431\u043E\u044E, \u0442\u0430\u043A \u0438 \u0432 \u0440\u0443\u0431\u043A\u0435
      \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u044B. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0421\u0447\u0438\u0442\u0430\u0439 \u044D\u0442\u043E \u043F\u043E\u0434\u0430\u0440\u043A\u043E\u043C
      \u0437\u0430 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0435 \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0411\u043E\u0431"
    dialogueCharacter: {fileID: 11400000, guid: c408fcc1b7a5ff04db16bd0bfb473796,
      type: 2}
    emotionId: 9
    delay: 0
    text: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E, \u043C\u043E\u0439
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0431\u043E\u0435\u0432\u043E\u0439 \u0442\u043E\u043F\u043E\u0440! "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0411\u043E\u0431"
    dialogueCharacter: {fileID: 11400000, guid: c408fcc1b7a5ff04db16bd0bfb473796,
      type: 2}
    emotionId: 9
    delay: 0
    text: "\u042F \u0434\u043E\u043B\u0436\u0435\u043D \u043D\u0430\u0437\u0432\u0430\u0442\u044C
      \u0442\u0435\u0431\u044F... "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0411\u043E\u0431"
    dialogueCharacter: {fileID: 11400000, guid: c408fcc1b7a5ff04db16bd0bfb473796,
      type: 2}
    emotionId: 7
    delay: 0
    text: "\u043D\u043E \u043A\u0430\u043A?"
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
