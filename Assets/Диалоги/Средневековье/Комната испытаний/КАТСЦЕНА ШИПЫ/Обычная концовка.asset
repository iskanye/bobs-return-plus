  m_Script: {fileID: 11500000, guid: 613d5eea99f9bff1c8f0fb7687a3251e, type: 3}
  m_Name: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F \u043A\u043E\u043D\u0446\u043E\u0432\u043A\u0430"
  m_EditorClassIdentifier: 
  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u041F\u043E\u0441\u043B\u0435 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0430
      \u0441 \u043E\u0441\u0442\u0440\u044B\u043C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u043C,
      \u043F\u043E\u043C\u0438\u043C\u043E \u043E\u0441\u0442\u0440\u043E\u0439 \u0431\u043E\u043B\u0438
      \u0442\u044B \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u0437\u0430\u043D\u0435\u0441\u0451\u0448\u044C
      \u0438\u043D\u0444\u0435\u043A\u0446\u0438\u044E \u0432 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0432\u0448\u0443\u044E\u0441\u044F
      \u0440\u0430\u043D\u0443."
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u041F\u0440\u0438 \u043F\u043E\u043F\u044B\u0442\u043A\u0435 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
      \u0432\u044B\u0442\u0430\u0449\u0438\u0442\u044C \u043E\u0441\u0442\u0440\u0438\u0451
      \u0442\u044B \u0440\u0438\u0441\u043A\u0443\u0435\u0448\u044C \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043C\u0435\u043B\u043A\u0438\u0435 \u0447\u0430\u0441\u0442\u0438\u0447\u043A\u0438
      \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u0432\u043D\u0443\u0442\u0440\u0438
      \u0440\u0430\u043D\u044B, \u0437\u0430\u0433\u043D\u043E\u0438\u0442\u044C
      \u0435\u0451, \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u0442\u044C \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u044F,
      \u043A\u043E\u0441\u0442\u0438..."
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0422\u0440\u0435\u0432\u0435\u043B \u0411\u043E\u0431"
    dialogueCharacter: {fileID: 11400000, guid: c408fcc1b7a5ff04db16bd0bfb473796,
      type: 2}
    emotionId: 8
    delay: 0
    text: "\u0410"
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0411\u043B\u0430\u0433\u043E \u0442\u044B \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C
      \u0442\u043E\u043B\u0441\u0442\u043E\u0439 \u043F\u043E\u0434\u043E\u0448\u0432\u044B,
      \u0442\u0430\u043A \u0447\u0442\u043E \u043E\u0431\u043E\u0439\u0434\u0451\u043C\u0441\u044F
      \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0431\u043E\u043B\u044C\u044E. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0417\u043D\u0430\u0435\u0448\u044C, \u0443 \u0442\u0435\u0431\u044F
      \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043D\u0438\u0437\u043A\u0438\u0439
      \u0431\u043E\u043B\u0435\u0432\u043E\u0439 \u043F\u043E\u0440\u043E\u0433."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u041A \u0441\u043B\u043E\u0432\u0443, \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0435
      \"\u041D\u0438 \u0446\u0430\u0440\u0430\u043F\u0438\u043D\u044B\" \u0442\u0435\u0431\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E."
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0422\u0440\u0435\u0432\u0435\u043B \u0411\u043E\u0431"
    dialogueCharacter: {fileID: 11400000, guid: c408fcc1b7a5ff04db16bd0bfb473796,
      type: 2}
    emotionId: 8
    delay: 0
    text: ...
    startDelay: 0
