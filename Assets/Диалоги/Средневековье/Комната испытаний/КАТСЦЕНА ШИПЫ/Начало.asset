  m_Script: {fileID: 11500000, guid: 613d5eea99f9bff1c8f0fb7687a3251e, type: 3}
  m_Name: "\u041D\u0430\u0447\u0430\u043B\u043E"
  m_EditorClassIdentifier: 
  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0410 \u0432\u043E\u0442 \u0438 \u0442\u0432\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "- \u043E\u0441\u0442\u0440\u044B\u0435 \u0448\u0438\u043F\u044B. "
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0414\u0443\u043C\u0430\u044E, \u0442\u044B \u0441 \u043D\u0438\u043C\u0438
      \u0445\u043E\u0440\u043E\u0448\u043E \u0437\u043D\u0430\u043A\u043E\u043C. "
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0412\u0441\u0451 \u043F\u0440\u043E\u0441\u0442\u043E: "
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0435\u0448\u044C \u043D\u0430
      \u043B\u043E\u0432\u0443\u0448\u043A\u0443 - \u0432 \u0442\u0432\u043E\u0438
      \u043F\u044F\u0442\u043A\u0438 \u0432\u043E\u043D\u0437\u0430\u0435\u0442\u0441\u044F
      \u043E\u0441\u0442\u0440\u0438\u0451. "
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0418 \u044D\u0442\u043E \u0432 \u043B\u0443\u0447\u0448\u0435\u043C
      \u0441\u043B\u0443\u0447\u0430\u0435! "
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0415\u0441\u043B\u0438 \u0432 \u0440\u0430\u043D\u0443 \u043F\u043E\u043F\u0430\u0434\u0451\u0442
      \u0438\u043D\u0444\u0435\u043A\u0446\u0438\u044F, \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u043F\u0440\u0438\u0431\u0435\u0433\u043D\u0443\u0442\u044C \u043A \u043F\u0435\u0440\u0435\u043A\u0438\u0441\u0438
      \u0438 \u0437\u0435\u043B\u0451\u043D\u043A\u0435! "
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0443\u0423\u0445..."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0422\u0440\u0435\u0432\u0435\u043B \u0411\u043E\u0431"
    dialogueCharacter: {fileID: 11400000, guid: c408fcc1b7a5ff04db16bd0bfb473796,
      type: 2}
    emotionId: 8
    delay: 0
    text: "\u0428\u0438\u043F\u044B!? "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0422\u0440\u0435\u0432\u0435\u043B \u0411\u043E\u0431"
    dialogueCharacter: {fileID: 11400000, guid: c408fcc1b7a5ff04db16bd0bfb473796,
      type: 2}
    emotionId: 8
    delay: 0
    text: "\u041D\u0438 \u0437\u0430 \u0447\u0442\u043E, \u044F \u043D\u0435 \u0445\u043E\u0447\u0443
      \u0431\u044B\u0442\u044C \u0411\u043E\u0448\u0438!"
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u041D\u0435 \u0431\u043E\u0439\u0441\u044F, \u0411\u043E\u0431, \u0437\u0434\u0435\u0441\u044C
      \u043D\u0435\u0442 \u043D\u0438\u043A\u0430\u043A\u0438\u0445 \u043E\u0447\u043A\u043E\u0432,
      \u0438 \u0442\u044B \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0448\u044C,
      \u043A\u0440\u043E\u043C\u0435 \u043E\u0434\u043D\u043E\u0439 \u0435\u0434\u0438\u043D\u0438\u0446\u044B
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u041D\u0435\u0443\u0436\u0442\u043E \u043F\u0435\u0440\u0435\u0434\u043E
      \u043C\u043D\u043E\u0439 \u043D\u0435 \u043C\u0430\u0441\u0442\u0435\u0440
      \u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u0440\u0438\u0441\u0442\u0430\u0432\u043A\u0438,
      \u0430 \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C \"\u043D\u0443\u0431\",
      \u0447\u0442\u043E \u043F\u043E\u0434\u0432\u0451\u043B \u0441\u0432\u043E\u0439
      \u043D\u0430\u0440\u043E\u0434?"
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0422\u0440\u0435\u0432\u0435\u043B \u0411\u043E\u0431"
    dialogueCharacter: {fileID: 11400000, guid: c408fcc1b7a5ff04db16bd0bfb473796,
      type: 2}
    emotionId: 8
    delay: 0
    text: "\u042D\u0442\u043E \u0431\u044B\u043B\u043E \u043F\u0435\u0440\u0432\u043E\u0435
      \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      600 \u0438\u0433\u0440...!"
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0422\u0440\u0435\u0432\u0435\u043B \u0411\u043E\u0431"
    dialogueCharacter: {fileID: 11400000, guid: c408fcc1b7a5ff04db16bd0bfb473796,
      type: 2}
    emotionId: 8
    delay: 0
    text: "\u041F\u043E\u0433\u043E\u0434\u0438\u0442\u0435, \u043E\u043D \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0434\u0431\u0438\u0442\u044C
      \u043C\u0435\u043D\u044F \u043D\u0430 \u0441\u043B\u0430\u0431\u043E. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0422\u0440\u0435\u0432\u0435\u043B \u0411\u043E\u0431"
    dialogueCharacter: {fileID: 11400000, guid: c408fcc1b7a5ff04db16bd0bfb473796,
      type: 2}
    emotionId: 8
    delay: 0
    text: "\u041A\u0430\u043A\u0430\u044F \u0434\u0435\u0442\u0441\u043A\u0430\u044F
      \u0438\u0433\u0440\u0430, \u0448\u0430\u0440\u0438\u043A. "
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0422\u0440\u0435\u0432\u0435\u043B \u0411\u043E\u0431"
    dialogueCharacter: {fileID: 11400000, guid: c408fcc1b7a5ff04db16bd0bfb473796,
      type: 2}
    emotionId: 8
    delay: 0
    text: "\u0420\u0430\u0437\u0443\u043C\u0435\u0435\u0442\u0441\u044F, \u043C\u043D\u0435
      \u041D\u0415 \u0441\u0442\u043E\u0438\u0442 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u044C
      \u043D\u0438 \u043D\u0430 \u0447\u0442\u043E \u043E\u0441\u0442\u0440\u043E\u0435."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
