  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0411\u043E\u0431, \u044D\u0442\u043E \u0442\u0432\u043E\u0439 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
