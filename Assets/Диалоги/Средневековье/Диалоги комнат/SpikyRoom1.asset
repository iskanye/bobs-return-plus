  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0413\u043B\u044F\u0434\u0438 \u0432 \u043E\u0431\u0430, \u0411\u043E\u0431! "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u041F\u043E\u043B \u0438 \u0441\u0442\u0435\u043D\u044B \u0432 \u044D\u0442\u043E\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u0443\u0441\u0435\u044F\u043D\u044B
      \u043E\u0441\u0442\u0440\u044B\u043C\u0438 \u043B\u0435\u0437\u0432\u0438\u044F\u043C\u0438. "
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0418 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0432
      30 \u0441\u0430\u043D\u0442\u0438\u043C\u0435\u0442\u0440\u043E\u0432 \u043C\u0435\u0436\u0434\u0443
      \u0442\u0432\u043E\u0435\u0439 \u0441\u0442\u0443\u043F\u043D\u0451\u0439 \u0438
      \u0448\u0438\u043F\u0430\u043C\u0438 \u0445\u0432\u0430\u0442\u0438\u0442 \u0434\u043B\u044F
      \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0430
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u043F\u0440\u043E\u043A\u043E\u043B\u043E\u0442\u043E\u0439
      \u0437\u0430\u0442\u043E\u0447\u0435\u043D\u043D\u044B\u043C\u0438 \u043E\u0441\u0442\u0440\u0438\u044F\u043C\u0438."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u0430\u0436\u0434\u043E\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0444\u043B\u0430\u0433. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0414\u043E\u0431\u0435\u0436\u0430\u043B \u0434\u043E \u0444\u043B\u0430\u0433\u0430
      - \u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u043F\u043E\u0437\u0430\u0434\u0438."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
