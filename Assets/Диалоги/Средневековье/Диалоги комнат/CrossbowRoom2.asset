  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0425\u043C, \u043D\u0430\u0434\u0435\u044E\u0441\u044C \u044D\u0442\u0438
      \u0448\u0430\u0440\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435 \u043E\u0440\u0443\u0434\u0438\u044F
      \u043D\u0435 \u0432\u044B\u0437\u043E\u0432\u0443\u0442 \u0443 \u0442\u0435\u0431\u044F
      \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0445 \u044D\u043C\u043E\u0446\u0438\u0439. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0432\u043D\u0443\u0442\u0440\u0438
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0441\u0442\u0440\u0435\u043B\u0430,
      \u0431\u0443\u0434\u044C \u043D\u0430 \u0447\u0435\u043A\u0443."
