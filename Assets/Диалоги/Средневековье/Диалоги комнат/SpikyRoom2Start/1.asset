      type: 2}
    emotionId: 1
    delay: 0
    text: "\u0422\u0430\u043A \u043A\u0430\u043A \u0442\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0448\u044C\u0441\u044F
