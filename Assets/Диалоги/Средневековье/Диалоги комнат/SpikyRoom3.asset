  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u041F\u043E\u0445\u043E\u0436\u0435, \u044D\u0442\u0430 \u043A\u043E\u043C\u043D\u0430\u0442\u0430
      \u0441\u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u0441\u0451, \u0447\u0442\u043E\u0431\u044B
      \u0442\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F."
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C,
      \u0447\u0442\u043E \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043C\u043D\u0430\u0442\u044B
      \u0442\u0435\u0431\u044F \u043E\u0436\u0438\u0434\u0430\u0435\u0442 \u043D\u043E\u0432\u0435\u0439\u0448\u0435\u0435
      \u043D\u0430\u0443\u0447\u043D\u043E\u0435 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435."
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0411\u043E\u0431"
    dialogueCharacter: {fileID: 11400000, guid: c408fcc1b7a5ff04db16bd0bfb473796,
      type: 2}
    emotionId: 7
