  m_Script: {fileID: 11500000, guid: 613d5eea99f9bff1c8f0fb7687a3251e, type: 3}
  m_Name: CrossbowRoom1
  m_EditorClassIdentifier: 
  dialogues:
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 1
    delay: 0
    text: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0442\u0435\u0431\u044F \u0430\u0440\u0431\u0430\u043B\u0435\u0442\u043E\u043C,
      \u0438\u043B\u0438, \u043A\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u0432 \u0434\u0440\u0435\u0432\u043D\u043E\u0441\u0442\u0438, \u0441\u0430\u043C\u043E\u0441\u0442\u0440\u0435\u043B\u043E\u043C. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 3
    delay: 0
    text: "\u041F\u043E \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u043E\u0439 \u0441\u0438\u043B\u0435,
      \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0438 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438
      \u0430\u0440\u0431\u0430\u043B\u0435\u0442 \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u0438\u0442 \u0441\u0432\u043E\u0435\u0433\u043E
      \u043F\u0440\u0430\u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044F - \u043B\u0443\u043A. "
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 3
    delay: 0
    text: "\u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u0434\u0430\u0436\u0435
      \u043D\u0430 \u043D\u0430\u0442\u044F\u0436\u0435\u043D\u0438\u0435 \u0445\u0443\u0434\u0448\u0438\u0445
      \u0432\u0435\u0440\u0441\u0438\u0439 \u0430\u0440\u0431\u0430\u043B\u0435\u0442\u0430
      \u0442\u0440\u0430\u0442\u0438\u0442\u0441\u044F \u043C\u0435\u043D\u044C\u0448\u0435
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438, \u043A\u0430\u043A \u043C\u0438\u043D\u0438\u043C\u0443\u043C
      \u0438\u0437-\u0437\u0430 \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
      \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u0434\u0440\u0443\u0433\u0438\u0445
      \u0433\u0440\u0443\u043F\u043F \u043C\u044B\u0448\u0446."
    startDelay: 0
    clearPreviousText: 0
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
  - character: "\u0414\u0438\u043A\u0442\u043E\u0440"
    dialogueCharacter: {fileID: 11400000, guid: 08c1422a1f2209a4aa92a73397c1758a,
      type: 2}
    emotionId: 3
    delay: 0
    text: "\u0422\u0435\u0431\u0435 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u0431\u044B\u0442\u044C \u043F\u0440\u0435\u0434\u0435\u043B\u044C\u043D\u043E
      \u043B\u043E\u0432\u043A\u0438\u043C, \u0411\u043E\u0431, \u0432\u0435\u0434\u044C
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0443\u0437\u043D\u0430\u0435\u0448\u044C
      \u043A\u043E\u0433\u0434\u0430 \u044D\u0442\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
      \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442 \u0432\u044B\u0441\u0442\u0440\u0435\u043B."
    startDelay: 0
    clearPreviousText: 1
    showStraightaway: 0
    dontWait: 0
    cantSkip: 0
