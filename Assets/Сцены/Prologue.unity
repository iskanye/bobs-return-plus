  m_Script: {fileID: 11500000, guid: af55adfff44e13f4d832ad4c7cd720ed, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  frames:
  - sprite: {fileID: 21300000, guid: f6964574e40359f4c9a6853b99a95c8f, type: 3}
    text: "\u0412 \u043E\u0434\u043D\u043E\u0439 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438..."
    waitTime: 7.4
    fadeIn: 1
    showTextBox: 0
  - sprite: {fileID: 21300000, guid: c2c674c66c60e144aab804082ab1f92d, type: 3}
    text: "...\u043D\u0430\u0434 \u043A\u043B\u043E\u043D\u0430\u043C\u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442\u0441\u044F
      \u0436\u0435\u0441\u0442\u043E\u043A\u0438\u0435 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u044B."
    waitTime: 7.4
    fadeIn: 1
    showTextBox: 1
  - sprite: {fileID: 21300000, guid: 3981ec275b852f446989e7930b3df038, type: 3}
    text: "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u043A\u043B\u043E\u043D, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u043E\u0433
      \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u0442\u043E\u044F\u0442\u044C
      \u0414\u0438\u043A\u0442\u043E\u0440\u0443."
    waitTime: 6.45
    fadeIn: 1
    showTextBox: 0
  - sprite: {fileID: 21300000, guid: ab32d770423e83b42a34a75b7cd83f73, type: 3}
    text: "\u0421\u043E\u0431\u0440\u0430\u0432 \u043A\u043E\u043C\u0430\u043D\u0434\u0443
      \u0438\u0437 \u0441\u0435\u043C\u0438 \u0445\u0440\u0430\u0431\u0440\u044B\u0445
      \u043A\u043B\u043E\u043D\u043E\u0432, \u043E\u043D \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u043A\u043E\u043D\u0435\u0446
      \u0435\u0433\u043E \u0442\u0438\u0440\u0430\u043D\u0438\u0438."
    waitTime: 6.6
    fadeIn: 1
    showTextBox: 1
  - sprite: {fileID: 0}
    text: "\u041E\u0434\u043D\u0430\u043A\u043E \u0432\u043B\u0430\u0441\u0442\u044C
      \u0443\u0447\u0451\u043D\u043E\u0433\u043E \u043D\u0430\u0434 \u043F\u0440\u043E\u0435\u043A\u0446\u0438\u044F\u043C\u0438
      \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0430 \u0435\u043C\u0443 \u043F\u043E\u0431\u0435\u0434\u0443."
    waitTime: 4.2
    fadeIn: 1
    showTextBox: 0
  - sprite: {fileID: 21300000, guid: 8399e34cbe6dbcd469bdd767ebaa501d, type: 3}
    text: 
    waitTime: 3.9
    fadeIn: 0
    showTextBox: 0
  - sprite: {fileID: 21300000, guid: 11a2a93af44650c4bbc70293800ff60f, type: 3}
    text: 
    waitTime: 3.9
    fadeIn: 0
    showTextBox: 0
  - sprite: {fileID: 21300000, guid: c828e71f68477ff4f8cd96f6c7d52b51, type: 3}
    text: 
    waitTime: 3.9
    fadeIn: 0
    showTextBox: 0
  - sprite: {fileID: 0}
    text: 
    waitTime: 3.5
    fadeIn: 0
    showTextBox: 0
  - sprite: {fileID: 21300000, guid: 2d0df28506fff0d49891ea3a9af34745, type: 3}
    text: "\u0421\u043E\u0440\u0430\u0442\u043D\u0438\u043A\u0438 \u0431\u044B\u043B\u0438
      \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u044B \u0432 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B.
      \u041E\u0434\u043D\u0430\u043A\u043E \u043A\u0440\u0430\u0441\u043D\u044B\u0439
      \u0441\u043C\u043E\u0433 \u0441\u043A\u0440\u044B\u0442\u044C\u0441\u044F \u043E\u0442
      \u0414\u0438\u043A\u0442\u043E\u0440\u0430."
    waitTime: 12
    fadeIn: 1
    showTextBox: 1
  - sprite: {fileID: 21300000, guid: 7d32a02ca6ce20848a94274a89c385ae, type: 3}
    text: "\u0421 \u0442\u0435\u0445 \u043F\u043E\u0440 \u0435\u0433\u043E \u0441\u0435\u0440\u0434\u0446\u0435
      \u0436\u0430\u0436\u0434\u0435\u0442 \u043C\u0435\u0441\u0442\u0438, \u0430
      \u0440\u0430\u0437\u0443\u043C \u0441\u0442\u0440\u043E\u0438\u0442 \u043F\u043B\u0430\u043D\u044B
      \u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439, \u0431\u043E\u043B\u0435\u0435
      \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u043D\u043E\u0439 \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u0438..."
    waitTime: 12
    fadeIn: 1
    showTextBox: 0
